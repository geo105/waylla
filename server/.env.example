# Copia este archivo como  .env  y completa tu clave.
# Sin clave, el servidor funciona en modo SIMULADO (útil para probar el flujo).

# Clave de la API de Whisp (regístrate gratis en https://whisp.openforis.org)
WHISP_API_KEY=

# Base de la API de Whisp (verifica la URL vigente en la documentación de Open Foris)
WHISP_BASE_URL=https://whisp.openforis.org/api

# Puerto local del servidor
PORT=8787
